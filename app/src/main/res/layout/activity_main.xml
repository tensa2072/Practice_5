<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="0dp"
            android:layout_height="135dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@color/design_default_color_primary_dark" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/profile" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameLayout">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Имя: Дмитрий Шестаков"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Возраст: 17 лет"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Специализация: Программист"
                android:textSize="20sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linearLayout">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Фото"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Проекты"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Достижения"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contactsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linearLayout2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Контакты"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Телефон: +7 (901) 097-77-67"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email: h2233531@gmail.com"
                android:textSize="18sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telegram: @idk"
                android:textSize="18sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tik-tok: @abracadabra"
                android:textSize="18sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="16dp"
            app:columnCount="3"
            app:rowCount="6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contactsLayout">

            <!-- Ряд 0 (первый) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="0"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im1" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="0"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im2" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="0"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im3" />

            <!-- Ряд 1 (второй) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im4" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im5" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im6" />

            <!-- Ряд 2 (третий) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="2"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im7" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="2"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im8" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="2"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im9" />

            <!-- Ряд 3 (четвёртый) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="3"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im10" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="3"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im11" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="3"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im12" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="4"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im13" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="4"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im14" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="4"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im15" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="0"
                android:layout_row="5"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im16" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="1"
                android:layout_row="5"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im17" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_column="2"
                android:layout_row="5"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/im18" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>